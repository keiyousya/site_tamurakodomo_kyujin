# Google 広告APIの認証情報（.env にコピーして埋める。.env はコミットしない）
# scripts/pull_secrets.sh を使えば Secret Manager から自動で作れる。手順は README.md

# 開発者トークン（keiyousya MCC の API センターで発行。全サイト共通）
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth2 クライアント（GCP keiyousya-sites-prod > OAuth クライアント「Google Ads CLI」）
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# scripts/regen_refresh_token.py で発行（端末ごとに発行する）
GOOGLE_ADS_REFRESH_TOKEN=

# 広告アカウントが MCC 配下にリンクされていないので、ログインIDも操作対象と同じにする
GOOGLE_ADS_LOGIN_CUSTOMER_ID=8532249376

# 操作対象: たむらこどもクリニック（看護師募集）の広告アカウント
GOOGLE_ADS_CUSTOMER_ID=8532249376

# google-ads ライブラリ必須（True 固定）
GOOGLE_ADS_USE_PROTO_PLUS=True
