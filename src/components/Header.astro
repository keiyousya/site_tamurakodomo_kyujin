---
const base = import.meta.env.BASE_URL;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-cloud-50/90 backdrop-blur-md border-b border-sky-200/50">
  <div class="mx-auto max-w-5xl flex items-center justify-between px-5 py-3">
    <a href={`${base}/`} class="flex flex-col">
      <span class="text-lg font-bold text-sky-700 font-display">たむらこどもクリニック</span>
      <span class="text-xs text-ink-500">群馬県前橋市</span>
    </a>
    <a
      href="#apply"
      class="rounded-full bg-warm-500 px-6 py-2 text-sm font-bold text-white transition-colors hover:bg-warm-600"
    >
      応募する
    </a>
  </div>
</header>
