---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import RequirementsTable from '@/components/RequirementsTable.astro';
import ApplyForm from '@/components/ApplyForm.astro';

import exteriorImg from '@/assets/images/exterior.jpg';
import doctorImg from '@/assets/images/doctor.jpg';
import treatmentImg from '@/assets/images/treatment.jpg';
import waitingImg from '@/assets/images/waiting.jpg';
import isolationImg from '@/assets/images/isolation.jpg';
import signageImg from '@/assets/images/signage.jpg';

const requirements = [
  { label: '募集職種', value: '看護師（正看護師・准看護師）' },
  { label: '採用予定人数', value: '1名' },
  { label: '雇用形態', value: 'パート' },
  {
    label: '仕事内容',
    value: `<ul class="list-disc pl-5 space-y-1">
      <li>診察の補助（問診・検査・処置のサポート）</li>
      <li>予防接種・健診の対応</li>
      <li>保護者への説明・指導</li>
      <li>院内の感染対策・環境整備</li>
    </ul>`,
  },
  {
    label: '応募資格',
    value: '看護師免許をお持ちの方（正看護師・准看護師）<br>※小児科経験不問・ブランクのある方も歓迎',
  },
  {
    label: '勤務時間',
    value: '14:00〜18:30',
  },
  {
    label: '勤務日数',
    value: '月・火・水・金のうち週2〜4日',
  },
  {
    label: '休日・休暇',
    value: '木曜・土曜・日曜・祝日休み<br>夏季休暇・年末年始休暇あり',
  },
  {
    label: '給与',
    value: '時給 1,600円〜<br>※経験・能力を考慮',
  },
  {
    label: '待遇・福利厚生',
    value: `<ul class="list-disc pl-5 space-y-1">
      <li>交通費支給（規定による）</li>
      <li>有給休暇あり（規定による）</li>
      <li>駐車場完備（車通勤OK）</li>
      <li>制服貸与</li>
    </ul>`,
  },
  {
    label: '現在のスタッフ構成',
    value: `<ul class="list-disc pl-5 space-y-1">
      <li>医師：1名（院長）</li>
      <li>看護師：常勤2名・パート3名</li>
      <li>医療事務：常勤2名・パート2名</li>
    </ul>`,
  },
  {
    label: '勤務地',
    value: 'たむらこどもクリニック<br>〒371-0013 群馬県前橋市西片貝町3丁目123-5',
  },
];
---

<Layout title="看護師パート募集｜たむらこどもクリニック｜前橋市・日勤のみ・ブランクOK">
  <Header />

  <!-- Hero -->
  <section
    data-hero
    class="relative flex min-h-[85vh] items-center justify-center pt-16 overflow-hidden"
  >
    <!-- 背景画像 -->
    <div class="absolute inset-0">
      <Image
        src={exteriorImg}
        alt="たむらこどもクリニック外観"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={80}
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-[oklch(0.28_0.08_240/0.70)] via-[oklch(0.28_0.08_240/0.55)] to-[oklch(0.28_0.08_240/0.80)]"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-5xl px-5 text-center">
      <p class="reveal mb-5 inline-block rounded-full bg-warm-500 px-6 py-1.5 text-sm font-bold text-white">
        看護師 募集中
      </p>
      <h1 class="reveal mb-6 text-3xl font-bold leading-snug text-white md:text-5xl font-display drop-shadow-lg" style="transition-delay:100ms">
        子どもたちの笑顔に<br />囲まれて働きませんか？
      </h1>
      <p class="reveal mx-auto mb-10 max-w-lg text-base text-white/90 drop-shadow" style="transition-delay:200ms">
        群馬県前橋市のたむらこどもクリニックでは、一緒に子どもたちの健康を支えてくれる看護師スタッフを募集しています。午後パート・日勤のみ・ブランクOK。
      </p>
      <a
        href="#requirements"
        class="reveal inline-block rounded-full bg-warm-500 px-10 py-4 text-base font-bold text-white shadow-lg transition-all hover:-translate-y-0.5 hover:bg-warm-600 hover:shadow-xl"
        style="transition-delay:300ms"
      >
        募集要項を見る
      </a>
    </div>

    <!-- 装飾: 波 -->
    <div class="absolute bottom-0 left-0 right-0 z-10">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="block w-full">
        <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 50 1440 45V80H0V40Z" fill="oklch(0.995 0.003 240)" />
      </svg>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 md:py-28 bg-cloud-50" id="features">
    <div class="mx-auto max-w-5xl px-5">
      <SectionHeading label="why us" title="当院で働く魅力" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <FeatureCard title="アットホームな職場" text="少人数のスタッフで協力し合いながら働く、温かい雰囲気のクリニックです。" delay={0}>
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </FeatureCard>
        <FeatureCard title="働きやすい勤務体制" text="日勤のみで夜勤なし。プライベートとの両立がしやすい環境です。" delay={100}>
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </FeatureCard>
        <FeatureCard title="小児科の経験が積める" text="小児科未経験でも丁寧に指導します。子ども好きな方を歓迎します。" delay={200}>
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </FeatureCard>
      </div>
    </div>
  </section>

  <!-- Director Message -->
  <section class="py-20 md:py-28 bg-white" id="message">
    <div class="mx-auto max-w-4xl px-5">
      <SectionHeading label="message" title="院長メッセージ" />
      <div class="reveal flex flex-col items-center gap-8 md:flex-row md:items-start">
        <Image
          src={doctorImg}
          alt="院長 田村一志"
          width={256}
          format="webp"
          quality={80}
          class="h-64 w-64 shrink-0 rounded-2xl object-cover shadow-sm"
        />
        <div>
          <p class="mb-4 leading-relaxed text-ink-700">
            当院は「子どもたちが安心して来られるクリニック」を目指し、スタッフ全員が笑顔で対応することを大切にしています。
          </p>
          <p class="mb-4 leading-relaxed text-ink-700">
            小児科の経験がない方でも、子どもが好きという気持ちがあれば大歓迎です。丁寧に指導しますので、安心してご応募ください。
          </p>
          <p class="leading-relaxed text-ink-700">
            一緒に子どもたちの健康を守り、成長を見守っていきましょう。ご応募をお待ちしています。
          </p>
          <p class="mt-4 text-lg font-bold text-sky-700 text-right">院長　田村 一志</p>
          <p class="mt-1 text-xs text-ink-500 text-right">医学博士・日本小児科学会認定専門医 / 認定指導医</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="py-20 md:py-28 bg-sky-50" id="gallery">
    <div class="mx-auto max-w-5xl px-5">
      <SectionHeading label="gallery" title="クリニックの様子" />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="reveal group overflow-hidden rounded-2xl shadow-sm">
          <Image src={exteriorImg} alt="クリニック外観" width={600} format="webp" quality={80} class="h-56 w-full object-cover transition-transform duration-300 group-hover:scale-105" />
          <div class="bg-white px-4 py-3">
            <p class="text-sm font-bold text-ink-800">クリニック外観</p>
            <p class="text-xs text-ink-500">駐車場完備で車通勤OK</p>
          </div>
        </div>
        <div class="reveal group overflow-hidden rounded-2xl shadow-sm" style="transition-delay:100ms">
          <Image src={signageImg} alt="看板" width={600} format="webp" quality={80} class="h-56 w-full object-contain bg-sky-100 transition-transform duration-300 group-hover:scale-105" />
          <div class="bg-white px-4 py-3">
            <p class="text-sm font-bold text-ink-800">看板</p>
            <p class="text-xs text-ink-500">カンガルーが目印の看板</p>
          </div>
        </div>
        <div class="reveal group overflow-hidden rounded-2xl shadow-sm" style="transition-delay:200ms">
          <Image src={treatmentImg} alt="待合スペース" width={600} format="webp" quality={80} class="h-56 w-full object-cover transition-transform duration-300 group-hover:scale-105" />
          <div class="bg-white px-4 py-3">
            <p class="text-sm font-bold text-ink-800">待合スペース</p>
            <p class="text-xs text-ink-500">空と雲をモチーフにした明るい待合室</p>
          </div>
        </div>
        <div class="reveal group overflow-hidden rounded-2xl shadow-sm" style="transition-delay:300ms">
          <Image src={waitingImg} alt="プレイスペース" width={600} format="webp" quality={80} class="h-56 w-full object-cover transition-transform duration-300 group-hover:scale-105" />
          <div class="bg-white px-4 py-3">
            <p class="text-sm font-bold text-ink-800">プレイスペース</p>
            <p class="text-xs text-ink-500">お子さまが安心して待てる遊び場</p>
          </div>
        </div>
        <div class="reveal group overflow-hidden rounded-2xl shadow-sm" style="transition-delay:400ms">
          <Image src={isolationImg} alt="隔離診察室" width={600} format="webp" quality={80} class="h-56 w-full object-cover transition-transform duration-300 group-hover:scale-105" />
          <div class="bg-white px-4 py-3">
            <p class="text-sm font-bold text-ink-800">隔離診察室</p>
            <p class="text-xs text-ink-500">感染対策に配慮した個別の診察室</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Requirements -->
  <section class="py-20 md:py-28 bg-cloud-50" id="requirements">
    <div class="mx-auto max-w-3xl px-5">
      <SectionHeading label="requirements" title="募集要項" />
      <RequirementsTable rows={requirements} />
    </div>
  </section>

  <!-- Apply Form -->
  <section class="py-20 md:py-28 bg-cloud-50" id="apply">
    <div class="mx-auto max-w-3xl px-5">
      <SectionHeading label="apply" title="応募フォーム" />
      <p class="reveal mb-10 text-center text-ink-700">
        以下のフォームからご応募ください。<br class="md:hidden" />見学のみのご希望もお気軽にどうぞ。
      </p>
      <div class="reveal rounded-2xl bg-white px-4 py-8 md:px-8 shadow-sm">
        <ApplyForm />
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="py-20 md:py-28 bg-sky-50" id="contact">
    <div class="mx-auto max-w-3xl px-5">
      <SectionHeading label="contact" title="お電話でのお問い合わせ" />
      <div class="reveal mx-auto max-w-sm rounded-2xl bg-white p-8 text-center shadow-sm">
        <div class="mb-3 flex justify-center text-sky-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <a
          href="tel:027-289-0555"
          class="mb-3 inline-block text-2xl font-bold text-sky-600 transition-colors hover:text-sky-700"
        >
          027-289-0555
        </a>
        <p class="text-xs text-ink-500">受付時間：診療時間内<br />「求人を見た」とお伝えください</p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
