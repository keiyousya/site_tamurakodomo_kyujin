---
import '@/styles/global.css';
import { CONVERSION_TEL, GOOGLE_ADS_ID } from '@/config/ads';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '群馬県前橋市の小児科・たむらこどもクリニックで看護師パート募集中。午後のみ（14:00〜18:30）・日勤のみ・夜勤なし。正看護師・准看護師歓迎。小児科未経験・ブランクOK。時給1,600円〜。車通勤可。',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4fc3f7" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="google-site-verification" content="aJRqUn795aWjXAAwyrQPIcDGXtzK-2Q_FURUxS_1Vng" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&display=swap" />
    </noscript>

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google 広告: gtag.js と電話タップのコンバージョン計測（ID は src/config/ads.ts） -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ADS_ID}`}></script>
    <script is:inline define:vars={{ adsId: GOOGLE_ADS_ID, telConversion: CONVERSION_TEL }}>
      window.dataLayer = window.dataLayer || [];
      // define:vars で関数スコープに包まれるため、gtag は window に生やす
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      gtag('js', new Date());
      gtag('config', adsId);

      // ページ内のすべての tel: リンク（本文・フッター）をまとめて拾う
      document.addEventListener('click', function (e) {
        var link = e.target instanceof Element && e.target.closest('a[href^="tel:"]');
        if (link) gtag('event', 'conversion', { send_to: telConversion });
      });
    </script>

    <!-- 構造化データ: JobPosting (Google for Jobs 対応) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "JobPosting",
      "title": "看護師パート（正看護師・准看護師）",
      "description": "<p>群馬県前橋市の小児科クリニックで看護師パートを募集しています。</p><h3>仕事内容</h3><ul><li>診察の補助（問診・検査・処置のサポート）</li><li>予防接種・健診の対応</li><li>保護者への説明・指導</li><li>院内の感染対策・環境整備</li></ul><h3>勤務条件</h3><ul><li>勤務時間：14:00〜18:30</li><li>勤務日：月・火・水・金のうち週2〜4日</li><li>日勤のみ・夜勤なし</li><li>木曜・土曜・日曜・祝日休み</li><li>夏季休暇・年末年始休暇あり</li></ul><h3>応募資格</h3><p>看護師免許をお持ちの方（正看護師・准看護師）。小児科経験不問・ブランクのある方も歓迎します。</p><h3>待遇</h3><ul><li>時給1,600円〜（経験・能力を考慮）</li><li>交通費支給（規定による）</li><li>有給休暇あり</li><li>駐車場完備（車通勤OK）</li><li>制服貸与</li></ul>",
      "datePosted": "2026-09-10",
      "validThrough": "2027-03-31T23:59:59+09:00",
      "employmentType": "PART_TIME",
      "workHours": "14:00〜18:30（月・火・水・金のうち週2〜4日）",
      "jobBenefits": "交通費支給、有給休暇あり、駐車場完備（車通勤OK）、制服貸与",
      "directApply": true,
      "hiringOrganization": {
        "@type": "Organization",
        "name": "たむらこどもクリニック",
        "sameAs": "https://tamurakodomo-kyujin.web.app",
        "logo": "https://tamurakodomo-kyujin.web.app/favicon.svg",
        "address": {
          "@type": "PostalAddress",
          "postalCode": "371-0013",
          "addressRegion": "群馬県",
          "addressLocality": "前橋市",
          "streetAddress": "西片貝町3丁目123-5",
          "addressCountry": "JP"
        }
      },
      "jobLocation": {
        "@type": "Place",
        "address": {
          "@type": "PostalAddress",
          "postalCode": "371-0013",
          "addressRegion": "群馬県",
          "addressLocality": "前橋市",
          "streetAddress": "西片貝町3丁目123-5",
          "addressCountry": "JP"
        }
      },
      "baseSalary": {
        "@type": "MonetaryAmount",
        "currency": "JPY",
        "value": {
          "@type": "QuantitativeValue",
          "minValue": 1600,
          "unitText": "HOUR"
        }
      },
      "qualifications": "看護師免許（正看護師または准看護師）。小児科経験不問・ブランクOK。",
      "industry": "医療",
      "occupationalCategory": "29-1141.00"
    })} />

    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-cloud-50 text-ink-900 antialiased">
    <slot />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1 },
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // ヒーロー内は即座に表示
      const hero = document.querySelector('[data-hero]');
      if (hero) {
        hero.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
      }
    </script>
  </body>
</html>
